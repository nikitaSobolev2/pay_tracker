FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
# postinstall runs `prisma generate`; schema + placeholder URL must exist.
# Generate never connects; the real URL is injected at runtime.
ENV DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
RUN npm ci
COPY scripts ./scripts
COPY tsconfig.json ./
COPY src/lib/env.ts ./src/lib/env.ts
COPY scripts/fx-worker-entrypoint.sh ./fx-worker-entrypoint.sh
RUN chmod +x ./fx-worker-entrypoint.sh
ENTRYPOINT ["/bin/sh", "./fx-worker-entrypoint.sh"]
