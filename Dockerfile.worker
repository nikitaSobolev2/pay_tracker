FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY scripts ./scripts
COPY tsconfig.json ./
COPY src/lib/env.ts ./src/lib/env.ts
# Placeholder URL: prisma.config.ts requires DATABASE_URL, but `generate`
# never connects. The real URL is injected at runtime.
ENV DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
RUN npx prisma generate
COPY scripts/fx-worker-entrypoint.sh ./fx-worker-entrypoint.sh
RUN chmod +x ./fx-worker-entrypoint.sh
ENTRYPOINT ["/bin/sh", "./fx-worker-entrypoint.sh"]
