generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  SPENDING
  EARNING
}

enum TransactionKind {
  DEFAULT
  LOAN
  DEBT
  REFUND
  TRANSFER
  FORGIVE
}

enum AuthApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  CONSUMED
}

enum EventPublicity {
  PUBLIC
  PRIVATE
}

enum EventGuestPermission {
  VIEW
  EDIT
}

enum EventLinkType {
  LOCATION
  OTHER
}

enum EventSpendingCategory {
  FOOD
  DRINKS
  ALCOHOL
  HOUSING
  OTHER
}

enum EventAttendanceStatus {
  CERTAIN
  UNCERTAIN
}

enum EventAiReportType {
  OK
  BAD
}

enum EventPollStatus {
  OPEN
  FINISHED
}

enum EventPollSelectionMode {
  SINGLE
  MULTIPLE
}

enum EventPhase {
  PENDING
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum TravelPhase {
  PREPARES
  IN_PROGRESS
  FINISHED
  FAILED
}

enum TravelPlannedCategory {
  FOOD_DRINKS
  TRAVEL_EXPENSES
  HOUSING
  SOUVENIRS
  OTHER
}

enum TravelAiReportType {
  OK
  BAD
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  username        String   @unique
  displayUsername String?
  locale          String   @default("en")
  timezone        String   @default("UTC")
  theme           String   @default("system")
  defaultCurrency String   @default("RUB")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  categories     UserCategory[]
  counterparties UserCounterparty[]
  transactions   Transaction[]
  loginTransfers LoginTransfer[]
  sharedCharts   SharedChart[]
  events         Event[]
  travels        Travel[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LoginTransfer {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  token      String
  codeHash   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([codeHash])
}

model AuthApproval {
  id                 String             @id @default(cuid())
  tokenHash          String             @unique
  status             AuthApprovalStatus @default(PENDING)
  // Push flow: only this user may approve (the code/QR owner). Null = pull flow.
  boundUserId        String?
  // Set on approval; the account whose session the waiting device receives.
  approvedByUserId   String?
  requesterUserAgent String?
  requesterIp        String?
  locale             String             @default("en")
  expiresAt          DateTime
  resolvedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([boundUserId, status, expiresAt])
}

model UserCategory {
  id               String                @id @default(cuid())
  userId           String
  title            String
  type             TransactionType
  parentCategoryId String?
  keywords         String[]              @default([])
  createdAt        DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           UserCategory?         @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children         UserCategory[]        @relation("CategoryHierarchy")
  transactions     TransactionCategory[]

  @@index([userId, type, title])
  @@index([userId, type, parentCategoryId])
  @@index([parentCategoryId])
}

model UserCounterparty {
  id               String          @id @default(cuid())
  userId           String
  name             String
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  eventAttendances EventAttendee[]

  @@unique([userId, name])
  @@index([userId, name])
}

model Transaction {
  id             String                @id @default(cuid())
  userId         String
  type           TransactionType
  amount         Decimal               @db.Decimal(18, 4)
  inputCurrency  String
  originalAmount Decimal               @db.Decimal(18, 4)
  rateToRub      Decimal               @db.Decimal(18, 8)
  fxRateDate     DateTime              @db.Date
  title          String?
  occurredAt     DateTime
  kind           TransactionKind       @default(DEFAULT)
  counterpartyId String?
  travelId       String?
  idempotencyKey String
  isDeleted      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  counterparty   UserCounterparty?     @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  travel         Travel?               @relation(fields: [travelId], references: [id], onDelete: SetNull)
  categories     TransactionCategory[]

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([userId, kind, counterpartyId])
  @@index([userId, isDeleted, occurredAt])
  @@index([userId, travelId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rateToRub Decimal  @db.Decimal(18, 8)
  rateDate  DateTime @db.Date
  fetchedAt DateTime @default(now())
  source    String   @default("frankfurter")

  @@unique([currency, rateDate])
  @@index([rateDate])
}

model TransactionCategory {
  transactionId String
  categoryId    String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      UserCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([transactionId, categoryId])
  @@index([categoryId])
}

model SharedChart {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  chartType String
  payload   Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

model Event {
  id               String               @id @default(uuid())
  userId           String
  title            String
  /// Optional markdown blurb shown on the event page.
  description      String?
  occursAt         DateTime
  /// Optional end of the event; when set it must not precede occursAt.
  endsAt           DateTime?
  imageUrl         String?
  address          String?
  latitude         Decimal?             @db.Decimal(10, 7)
  longitude        Decimal?             @db.Decimal(10, 7)
  publicity        EventPublicity       @default(PRIVATE)
  guestPermission  EventGuestPermission @default(VIEW)
  currency         String
  /// Owner-set per-person share; null means compute from spendings.
  manualPerPersonAmount Decimal? @db.Decimal(18, 4)
  /// Owner name shown inside this event; falls back to User.name.
  ownerDisplayName String?
  /// Last owner heartbeat, so guests see the owner in the presence bar.
  ownerLastSeenAt  DateTime?
  /// Null = auto from occursAt/endsAt.
  phaseOverride    EventPhase?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]
  links     EventLink[]
  spendings EventSpending[]
  payments  EventPayment[]
  threads   EventCommentThread[]
  messages  EventChatMessage[]
  presences EventGuestPresence[]
  aiReport  EventAiReport?
  locationPolls EventLocationPoll[]

  @@index([userId, occursAt])
}

model EventAttendee {
  id             String                @id @default(cuid())
  eventId        String
  counterpartyId String
  status         EventAttendanceStatus @default(CERTAIN)
  /// Set when the event owner adds the person; guests use authorGuestId.
  authorUserId   String?
  authorGuestId  String?
  createdAt      DateTime              @default(now())

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  counterparty UserCounterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  authorGuest  GuestUser?       @relation(fields: [authorGuestId], references: [id], onDelete: SetNull)
  payments     EventPayment[]
  guestClaims  EventGuestPresence[]

  @@unique([eventId, counterpartyId])
  @@index([counterpartyId])
  @@index([authorGuestId])
}

model EventLink {
  id        String        @id @default(cuid())
  eventId   String
  type      EventLinkType @default(OTHER)
  title     String
  url       String
  createdAt DateTime      @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, type])
}

model EventSpending {
  id            String                @id @default(cuid())
  eventId       String
  title         String
  category      EventSpendingCategory @default(OTHER)
  /// Quantity, multiplied by price to get the row total.
  amount        Decimal               @db.Decimal(18, 4)
  /// Unit label such as "шт", "литр", "кг".
  amountUnit    String
  price         Decimal               @db.Decimal(18, 4)
  note          String?
  /// Set only when the author is the event owner; guests use authorGuestId.
  authorUserId  String?
  authorGuestId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorGuest GuestUser?           @relation(fields: [authorGuestId], references: [id], onDelete: SetNull)
  threads     EventCommentThread[]

  @@index([eventId, createdAt])
  @@index([authorGuestId])
}

model EventPayment {
  id         String   @id @default(cuid())
  eventId    String
  attendeeId String
  amount     Decimal  @db.Decimal(18, 4)
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([eventId, paidAt])
  @@index([attendeeId])
}

model EventCommentThread {
  id         String    @id @default(cuid())
  eventId    String
  spendingId String
  resolvedAt DateTime?
  /// Marks threads opened by the analyzer, so a re-run can replace its own output.
  createdByAi Boolean  @default(false)
  createdAt  DateTime  @default(now())

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  spending EventSpending  @relation(fields: [spendingId], references: [id], onDelete: Cascade)
  comments EventComment[]

  @@index([eventId, spendingId, createdAt])
}

model EventComment {
  id            String   @id @default(cuid())
  threadId      String
  body          String
  /// When set, the comment renders as a large image-only attachment.
  imageUrl      String?
  authorUserId  String?
  authorGuestId String?
  /// AI comments have neither author id and carry optional item suggestions.
  isAiGenerated   Boolean   @default(false)
  suggestedAmount Decimal?  @db.Decimal(18, 4)
  suggestedPrice  Decimal?  @db.Decimal(18, 4)
  amountAppliedAt DateTime?
  priceAppliedAt  DateTime?
  createdAt     DateTime @default(now())

  thread      EventCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorGuest GuestUser?         @relation(fields: [authorGuestId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([authorGuestId])
}

/// Latest analyzer verdict for an event; a re-run replaces the row.
model EventAiReport {
  id             String            @id @default(cuid())
  eventId        String            @unique
  type           EventAiReportType
  /// Markdown, rendered for every viewer of the event.
  reportMessage  String
  /// Extra hints the owner typed before the run.
  contextMessage String?
  /// Locale the report text was generated in (en/ru).
  responseLocale String?
  /// Structured missing-item suggestions from the latest analyze run.
  suggestedItems Json?
  model          String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventChatMessage {
  id            String   @id @default(cuid())
  eventId       String
  body          String
  /// When set, the message renders as a large image-only attachment.
  imageUrl      String?
  authorUserId  String?
  authorGuestId String?
  createdAt     DateTime @default(now())

  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorGuest GuestUser? @relation(fields: [authorGuestId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([authorGuestId])
}

model GuestUser {
  id         String   @id @default(uuid())
  name       String
  ipAddress  String?
  userAgent  String?
  locale     String   @default("en")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  presences       EventGuestPresence[]
  spendings       EventSpending[]
  comments        EventComment[]
  messages        EventChatMessage[]
  pollOptions     EventLocationPollOption[]
  pollVotes       EventLocationPollVote[]
  addedAttendees  EventAttendee[]
}

model EventGuestPresence {
  id          String   @id @default(cuid())
  eventId     String
  guestUserId String
  /// When set, this guest claimed an attendance list person for this event.
  attendeeId  String?
  lastSeenAt  DateTime @default(now())

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest    GuestUser      @relation(fields: [guestUserId], references: [id], onDelete: Cascade)
  attendee EventAttendee? @relation(fields: [attendeeId], references: [id], onDelete: SetNull)

  @@unique([eventId, guestUserId])
  @@index([eventId, lastSeenAt])
  @@index([eventId, attendeeId])
  @@index([attendeeId])
}

/// Housing / location vote for an event. At most one OPEN poll per event (enforced in service).
model EventLocationPoll {
  id               String                 @id @default(cuid())
  eventId          String
  title            String
  selectionMode    EventPollSelectionMode @default(SINGLE)
  endsAt           DateTime?
  status           EventPollStatus        @default(OPEN)
  finishedOptionId String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  event          Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  options        EventLocationPollOption[]
  votes          EventLocationPollVote[]
  finishedOption EventLocationPollOption?  @relation("FinishedPollOption", fields: [finishedOptionId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
}

model EventLocationPollOption {
  id            String   @id @default(cuid())
  pollId        String
  title         String
  link          String?
  address       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  imageUrl      String?
  authorUserId  String?
  authorGuestId String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  poll          EventLocationPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  authorGuest   GuestUser?         @relation(fields: [authorGuestId], references: [id], onDelete: SetNull)
  votes         EventLocationPollVote[]
  finishedFor   EventLocationPoll? @relation("FinishedPollOption")

  @@index([pollId, sortOrder])
  @@index([authorGuestId])
}

model EventLocationPollVote {
  id           String   @id @default(cuid())
  pollId       String
  optionId     String
  voterUserId  String?
  voterGuestId String?
  createdAt    DateTime @default(now())

  poll        EventLocationPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option      EventLocationPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterGuest  GuestUser?              @relation(fields: [voterGuestId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, voterUserId])
  @@unique([pollId, optionId, voterGuestId])
  @@index([pollId])
  @@index([optionId])
  @@index([voterGuestId])
}

model Travel {
  id               String       @id @default(uuid())
  userId           String
  title            String
  startsAt         DateTime
  endsAt           DateTime
  imageUrl         String?
  placeCountry     String?
  placeCity        String?
  placeLabel       String?
  housingAddress   String?
  housingLatitude  Decimal?     @db.Decimal(10, 7)
  housingLongitude Decimal?     @db.Decimal(10, 7)
  housingFloor     String?
  housingEntrance  String?
  housingApartment String?
  currency         String
  maxSpendingGoal  Decimal?     @db.Decimal(18, 4)
  phaseOverride    TravelPhase?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSpendings TravelPlannedSpending[]
  categoryBudgets  TravelCategoryBudget[]
  placesToVisit    TravelPlaceToVisit[]
  thingsToGrab     TravelThingToGrab[]
  tickets          TravelTicket[]
  transactions     Transaction[]
  aiReport         TravelAiReport?

  @@index([userId, startsAt])
  @@index([userId, endsAt])
}

model TravelPlannedSpending {
  id        String                @id @default(cuid())
  travelId  String
  title     String
  category  TravelPlannedCategory @default(OTHER)
  amount    Decimal               @db.Decimal(18, 4)
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([travelId, category])
}

/** Lump category total; when set, line items in that category are locked/hidden. */
model TravelCategoryBudget {
  id        String                @id @default(cuid())
  travelId  String
  category  TravelPlannedCategory
  amount    Decimal               @db.Decimal(18, 4)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@unique([travelId, category])
  @@index([travelId])
}

model TravelPlaceToVisit {
  id        String   @id @default(cuid())
  travelId  String
  title     String
  link      String?
  address   String?
  isChecked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([travelId])
}

model TravelThingToGrab {
  id        String   @id @default(cuid())
  travelId  String
  title     String
  amount    Int
  isChecked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([travelId])
}

model TravelTicket {
  id           String    @id @default(cuid())
  travelId     String
  title        String
  fileUrl      String
  fileName     String
  contentType  String
  origin       String?
  destination  String?
  departsAt    DateTime?
  arrivesAt    DateTime?
  ticketNumber String?
  flightNumber String?
  bookingCode  String?
  seat         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([travelId])
}

model TravelAiReport {
  id             String             @id @default(cuid())
  travelId       String             @unique
  type           TravelAiReportType
  reportMessage  String
  contextMessage String?
  responseLocale String?
  extras         Json?
  model          String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  travel Travel @relation(fields: [travelId], references: [id], onDelete: Cascade)
}
