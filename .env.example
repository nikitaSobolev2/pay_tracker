DATABASE_URL=postgresql://paytracker:paytracker@localhost:5433/paytracker
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
DEFAULT_CURRENCIES=RUB,USD,EUR
# Must mirror DEFAULT_CURRENCIES so the UI offers the same currencies.
# NEXT_PUBLIC_* is inlined at build time, so set it before `next build`.
NEXT_PUBLIC_DEFAULT_CURRENCIES=RUB,USD,EUR
DEFAULT_CURRENCY=RUB
DEFAULT_TIMEZONE=UTC
FX_PROVIDER=frankfurter
FX_API_BASE_URL=https://api.frankfurter.dev
FX_BACKFILL_DAYS=40
FX_FETCH_CRON=0 2 * * *
BACKUP_DIR=/backups
BACKUP_CRON=0 3 * * *
NEXT_PUBLIC_APP_NAME=PayTracker
# Local filesystem for event/travel uploads. Browsers hit S3_PUBLIC_URL.
STORAGE_BACKEND=fs
STORAGE_DIR=.data/files
S3_PUBLIC_URL=http://localhost:3000/files
# Yandex Maps — key from https://developer.tech.yandex.ru/ (JS API + Geocoder).
# If the key has HTTP Referer restrictions, allow your app host (e.g. localhost)
# and keep BETTER_AUTH_URL matching that origin so server geocode sends Referer.
# Address picker uses the JS key in-browser; YANDEX_GEOCODER_API_KEY is for /api/geocode.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
# Optional override if Referer must differ from BETTER_AUTH_URL:
# YANDEX_GEOCODER_REFERER=http://localhost:3000

# OpenAI-compatible endpoint used by the event analyzer.
AI_BASE_URL=https://api.artemox.com/v1
AI_API_KEY=change-me
AI_MODEL_ID=gpt-5-nano
AI_TIMEOUT_MS=120000
