DATABASE_URL=postgresql://paytracker:paytracker@localhost:5433/paytracker
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
DEFAULT_CURRENCIES=RUB,USD,EUR
# Must mirror DEFAULT_CURRENCIES so the UI offers the same currencies.
# NEXT_PUBLIC_* is inlined at build time, so set it before `next build`.
NEXT_PUBLIC_DEFAULT_CURRENCIES=RUB,USD,EUR
DEFAULT_CURRENCY=RUB
DEFAULT_TIMEZONE=UTC
FX_PROVIDER=frankfurter
FX_API_BASE_URL=https://api.frankfurter.dev
FX_BACKFILL_DAYS=40
FX_FETCH_CRON=0 2 * * *
BACKUP_DIR=/backups
BACKUP_CRON=0 3 * * *
NEXT_PUBLIC_APP_NAME=PayTracker
