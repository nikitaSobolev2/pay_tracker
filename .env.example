DATABASE_URL=postgresql://paytracker:paytracker@localhost:5433/paytracker
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
DEFAULT_CURRENCIES=RUB,USD,EUR
# Must mirror DEFAULT_CURRENCIES so the UI offers the same currencies.
# NEXT_PUBLIC_* is inlined at build time, so set it before `next build`.
NEXT_PUBLIC_DEFAULT_CURRENCIES=RUB,USD,EUR
DEFAULT_CURRENCY=RUB
DEFAULT_TIMEZONE=UTC
FX_PROVIDER=frankfurter
FX_API_BASE_URL=https://api.frankfurter.dev
FX_BACKFILL_DAYS=40
FX_FETCH_CRON=0 2 * * *
BACKUP_DIR=/backups
BACKUP_CRON=0 3 * * *
NEXT_PUBLIC_APP_NAME=PayTracker
# MinIO object storage for event cover images.
# S3_PUBLIC_URL is what browsers hit, so in production point it at the files subdomain.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=paytracker
S3_SECRET_KEY=paytracker-secret
S3_BUCKET=paytracker
S3_PUBLIC_URL=http://localhost:9000/paytracker
# Optional self-hosted Photon instance for address search.
# GEOCODE_BASE_URL=https://photon.komoot.io
# OpenAI-compatible endpoint used by the event analyzer.
AI_BASE_URL=https://api.artemox.com/v1
AI_API_KEY=change-me
AI_MODEL_ID=gpt-5-nano
AI_TIMEOUT_MS=120000
